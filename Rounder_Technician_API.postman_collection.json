                                    "key": "per_page",
                                    "value": "15"
                                },
                                {
                                    "key": "page",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "إرجاع قائمة بكافة الطلبات المسندة للفني. يقوم بحفظ أول booking_id تلقائياً في المتغيرات."
                    },
                    "response": []
                },
