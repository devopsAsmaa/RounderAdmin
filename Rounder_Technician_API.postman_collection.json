                {
                    "name": "GET General Me",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/me",
                        "description": "مسار /api/v1/me العام، يرجع بيانات المستخدم متضمنة is_technician و provider_profile_id."
                    },
                    "response": []
                }
            ]
        },
