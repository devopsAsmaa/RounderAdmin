        {
            "name": "5. Order Confirmation & OTP",
            "description": "إجراءات تحديث الحالة، إرسال رمز التحقق للعميل، وتأكيد الإتمام بالصورة والرمز.",
            "item": [
                {
                    "name": "PUT Update Status (In Progress)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status updated to in_progress\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(true);",
                                    "    pm.expect(jsonData.data.order.status.code).to.eql(\"in_progress\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"in_progress\",\n    \"note\": \"الفني في الطريق إلى موقع العميل وبدء التنفيذ\"\n}"
                        },
                        "url": "{{base_url}}/api/v1/technician/orders/{{booking_id}}/status",
                        "description": "تحديث حالة الطلب إلى (الفني في الطريق / قيد التنفيذ) دون اشتراط رمز أو صورة."
                    },
                    "response": []
                },
                {
                    "name": "POST Send Completion OTP to Client",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"OTP sent successfully\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(true);",
                                    "    if (jsonData.data && jsonData.data.otp) {",
                                    "        pm.collectionVariables.set(\"otp\", jsonData.data.otp);",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/technician/orders/{{booking_id}}/send-otp",
                        "description": "توليد وإرسال رمز تحقق OTP مكون من 6 أرقام إلى جوال العميل الساكن وإشعاره داخل التطبيق لتأكيد إتمام الخدمة. في بيئة التطوير والاختبار، يُعاد الرمز في الاستجابة ويُحفظ تلقائياً في متغير otp."
                    },
                    "response": []
                },
                {
                    "name": "POST Confirm Order Status with Image After & Client OTP",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Order confirmed and completed\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(true);",
                                    "    pm.expect(jsonData.data.order.status.code).to.eql(\"completed\");",
                                    "    pm.expect(jsonData.data.after_image).to.not.be.null;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "otp",
                                    "value": "{{otp}}",
                                    "description": "رمز التحقق المستلم من العميل (مطلوب)",
                                    "type": "text"
                                },
                                {
                                    "key": "image_after",
                                    "description": "صورة العمل المنفذ بعد الانتهاء (مطلوب - ملف صورة jpeg, png, jpg, webp)",
                                    "type": "file",
                                    "src": []
                                },
                                {
                                    "key": "note",
                                    "value": "تم إنجاز الصيانة بنجاح واختبار الخدمة بحضور العميل",
                                    "description": "ملاحظات الفني (اختياري)",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{base_url}}/api/v1/technician/orders/{{booking_id}}/confirm",
                        "description": "تأكيد إتمام الطلب بنجاح. يتطلب إرسال الـ OTP المستلم من العميل ورفع صورة بعد إنجاز العمل (image_after). يقوم بتحديث حالة الطلب إلى مكتمل completed وحفظ الصورة في الوسائط بنوع after وإشعار العميل وحساب عمولة المنصة."
                    },
                    "response": []
                }
            ]
        },
