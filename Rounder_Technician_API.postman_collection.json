{
    "info": {
        "name": "Rounder API — Technician App",
        "description": "مجموعة طلبات Postman لـ APIs الفني (Technician APIs) في منصة Rounder.\n\nتتضمن:\n1. المصادقة وتسجيل الدخول كفني أو مستخدم (Auth AS user).\n2. معلومات وبيانات الملف الشخصي والإحصائيات للفني (User info).\n3. استعراض الحالات المعتمدة للطلبات (list Statuses).\n4. استعراض وفلترة الطلبات المسندة للفني (list Orders).\n5. إرسال رمز التحقق للعميل وتأكيد إتمام الطلب بالصورة والرمز (confirm order status with image after and otp from client).\n\nالمتغيرات تحفظ تلقائياً (Token, Booking ID, OTP).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{technician_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "https://rounder-sa.com",
            "type": "string"
        },
        {
            "key": "technician_mobile",
            "value": "0550000001",
            "type": "string"
        },
        {
            "key": "technician_password",
            "value": "TechnicianPassword123!",
            "type": "string"
        },
        {
            "key": "technician_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "booking_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "emergency_request_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "otp",
            "value": "542187",
            "type": "string"
        },
        {
            "key": "locale",
            "value": "ar",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Authentication",
            "description": "عمليات تسجيل الدخول والمصادقة الخاصة بالفني.",
            "item": [
                {
                    "name": "POST Technician Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Login successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(true);",
                                    "    pm.expect(jsonData.data.token).to.not.be.empty;",
                                    "    pm.collectionVariables.set(\"technician_token\", jsonData.data.token);",
                                    "    if (pm.environment) {",
                                    "        pm.environment.set(\"token\", jsonData.data.token);",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"mobile\": \"{{technician_mobile}}\",\n    \"password\": \"{{technician_password}}\"\n}"
                        },
                        "url": "{{base_url}}/api/v1/technician/auth/login",
                        "description": "تسجيل دخول الفني عبر مسار الفنيين. يحفظ الـ Token تلقائياً في متغير technician_token."
                    },
                    "response": []
                },
                {
                    "name": "POST Standard User Login (as Technician)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"User Auth Login successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data.token).to.not.be.empty;",
                                    "    pm.collectionVariables.set(\"technician_token\", jsonData.data.token);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"mobile\": \"{{technician_mobile}}\",\n    \"password\": \"{{technician_password}}\"\n}"
                        },
                        "url": "{{base_url}}/api/v1/auth/login",
                        "description": "تسجيل دخول الفني عبر مسار المصادقة العام للمستخدمين (Auth AS user)."
                    },
                    "response": []
                },
                {
                    "name": "POST Technician Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Logout successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/technician/auth/logout",
                        "description": "تسجيل خروج الفني وإلغاء الـ Token الحالي."
                    },
                    "response": []
                }
            ]
        },
        {
