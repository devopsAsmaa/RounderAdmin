        {
            "name": "4. Orders (list Orders)",
            "description": "استعراض طلبات الخدمة المسندة للفني وتفاصيلها.",
            "item": [
                {
                    "name": "GET List All Assigned Orders",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Orders retrieved successfully\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(true);",
                                    "    if (jsonData.data && jsonData.data.length > 0) {",
                                    "        pm.collectionVariables.set(\"booking_id\", jsonData.data[0].id);",
                                    "    }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
